# Copy to .env.local and use your project's publishable key, never a secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Optional for manual editing; required for AI generation.
# Never prefix these variables with NEXT_PUBLIC_. Groq is the only configured provider.
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b hosted by Groq.
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Image/PDF answer key recognition uses a vision model hosted by Groq.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
